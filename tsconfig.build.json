{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": "./src",
    "plugins": [
      {
        "transform": "typescript-transform-paths"
      }
    ],
    "paths": {
      "@/*": [
        "*"
      ],
      "@src/*": [
        "*"
      ],
      "@entity/*": [
        "entity/*"
      ],
      "@constants/*": [
        "constants/*"
      ],
      "@helpers/*": [
        "helpers/*"
      ],
      "@validators/*": [
        "validators/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}